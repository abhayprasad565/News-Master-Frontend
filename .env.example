# ==============================================================================
# NEWS MASTER FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Dev Server Port
PORT=5173

# Base Path
BASE_PATH=/

# Backend API Proxy Target (for local development)
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
VITE_API_PROXY_STRIP_PREFIX=true

# Cloudflare Turnstile Public Site Key (from Cloudflare Dashboard -> Turnstile)
# Leave blank in development to use Cloudflare's automatic testing widget
VITE_TURNSTILE_SITE_KEY=
